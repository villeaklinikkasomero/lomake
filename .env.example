# Kopioi .env-tiedostoksi tai aseta ympäristömuuttujina
PORT=3000
NODE_ENV=production
SESSION_SECRET=vaihda-pitkaan-satunnaiseen-merkkijonoon
SESSION_HOURS=10
DB_PATH=./data/kohtaamiset.db
# Ensimmäinen admin luodaan näillä, jos admin-käyttäjiä ei vielä ole
ADMIN_EMAIL=etunimi.sukunimi@a-klinikka.fi
ADMIN_PASSWORD=
LOGIN_RATE_LIMIT=10
# Asiakastunnisteiden suojausavain (HMAC). Vähintään 16 merkkiä, satunnainen.
# Säilytä turvallisesti; avaimen vaihto katkaisee kaikki asiakaslinkitykset.
PSEUDONYM_KEY=
# Linkitys katkaistaan, kun asiakasta ei ole kohdattu näin moneen kuukauteen
CLIENT_RETENTION_MONTHS=24
# Kaksivaiheinen tunnistautuminen (todennussovellus) salasanatunnuksille. Oletus: päällä.
MFA_REQUIRED=true
# Sovelluksen julkinen osoite (Microsoft-kirjautumisen paluuosoite johdetaan tästä)
APP_URL=https://kohtaamisten-raportointi.onrender.com
# Microsoft Entra ID -kirjautuminen säätiön työntekijöille (kaikki kolme tarvitaan)
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
# Valinnainen: oma paluuosoite, jos eri kuin APP_URL + /auth/callback
# ENTRA_REDIRECT_URI=
# Kadunnimiehdotukset sovelluksen omasta aineistosta (DVV:n osoitetiedot). off = pois päältä
STREET_SOURCE=on
